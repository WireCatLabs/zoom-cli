{
  "name": "@wirecat/zoom-cli",
  "version": "0.35.0",
  "description": "Zoom cloud recording archives, persistent transcripts and meeting tools",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/zoom-cli.git"
  },
  "bin": {
    "zm": "dist/bin/zm.js"
  },
  "files": [
    "dist",
    "skills",
    "scenarios",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build --force",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:bun": "bun run scripts/smoke.ts",
    "prepublishOnly": "pnpm build",
    "docs:check": "node node_modules/@wirecat/cli-base/dist/dev/bin.js docs-check --rules scripts/docs-rules.ts --pages && cspell --no-progress --no-summary README.md && node node_modules/rumdl/bin/rumdl check --config config/wirecat/rumdl.toml README.md CHANGELOG.md CLAUDE.md docs/*.md docs/dev/*.md",
    "standards:check": "node config/wirecat/check.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md",
    "prepare": "lefthook install || true",
    "ci:quick": "pnpm typecheck",
    "contracts:check": "cli-contract contracts/plan.json",
    "generate": "pnpm build && node scripts/commands.ts",
    "generate:check": "pnpm build && node scripts/commands.ts --check",
    "test:matrix": "pnpm test --maxWorkers 2 && pnpm build && pnpm test:matrix:check",
    "lint:commands": "node node_modules/@wirecat/cli-base/dist/dev/bin.js lint --cli dist/bin/zm.js",
    "test:matrix:check": "node node_modules/@wirecat/cli-base/dist/dev/bin.js test-matrix --program scripts/command-program.ts --untested scripts/test-matrix-untested.ts --name zm --check && git diff --exit-code -- docs/dev/test-matrix.md",
    "contracts:upgrade": "pnpm --dir contracts/previous install --frozen-lockfile --ignore-scripts && cli-contract contracts/upgrade.json",
    "security:no-leak": "cli-testing security no-leak . contracts/no-leak.json",
    "version:check": "node node_modules/@wirecat/cli-base/dist/dev/bin.js version",
    "version:sync": "node node_modules/@wirecat/cli-base/dist/dev/bin.js version --sync",
    "package:check": "node scripts/package-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@wirecat/cli-base": "0.49.0",
    "@wirecat/cli-core": "0.389.0",
    "commander": "15.0.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cspell/dict-en-gb": "5.0.34",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.3",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@wirecat/cli-testing": "0.5.2",
    "cspell": "10.3.6",
    "lefthook": "2.1.16",
    "markdownlint-cli2": "0.23.3",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
