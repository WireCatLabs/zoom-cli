#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."
[ "$#" -eq 0 ] || { echo "usage: bin/release" >&2; exit 2; }
git fetch -q origin
[ "$(git branch --show-current)" = main ] || { echo "run from main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "update main to origin/main first" >&2; exit 1; }
# Serialize publishing across the owner's CLI packages, as in cli-core.
lock="${XDG_RUNTIME_DIR:-/tmp}/leemour-release.lock"
exec 9>"$lock"
flock -n 9 || { echo "another release is running: $(cat "$lock.who" 2>/dev/null)" >&2; exit 1; }
echo "$(basename "$PWD") pid $$ since $(date -u +%H:%M)" > "$lock.who"
version=$(node -p 'require("./package.json").version')
# A session that merges after the version was dated, but before it was published, adds Unreleased above it.
# cli-dev is pinned rather than taken from the dependencies: cli-core accepts only an older cli-base.
folded=""
npm view "@wirecat/zoom-cli@$version" version --prefer-online >/dev/null 2>&1 ||
  folded=$(npx -y -p @wirecat/cli-base@0.34.0 cli-dev changelog fold --version "$version")
if [ -n "$folded" ]; then
  echo "$folded"
  # main takes changes only through a pull request (the repository's ruleset).
  branch="release/fold-$version" title="chore(release): fold Unreleased into $version"
  body="bin/release: $version is dated but not on npm, and Unreleased sat above it. Only CHANGELOG.md changes."
  git switch -q -c "$branch"
  git commit -q -am "$title" -m "$body"
  git push -q -u origin "$branch"
  git switch -q main
  pr=$(gh pr create --base main --head "$branch" --title "$title" --body "$body")
  # Checks register a few seconds after the pull request; --watch with none exits at once.
  for _ in $(seq 30); do
    [ "$(gh pr checks "$pr" --json name --jq length 2>/dev/null || echo 0)" -gt 0 ] && break
    sleep 2
  done
  gh pr checks "$pr" --watch --fail-fast >/dev/null || { echo "checks failed on $pr — nothing is published" >&2; exit 1; }
  gh pr merge "$pr" --squash --delete-branch --subject "$title (#${pr##*/})"
  git fetch -q origin
  git merge -q --ff-only origin/main
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is not origin/main after $pr" >&2; exit 1; }
fi
top=$(sed -n '/^## /{p;q;}' CHANGELOG.md)
case "$top" in
  "## $version — "*) ;;
  *) echo "date the top changelog section for $version before releasing" >&2; exit 1 ;;
esac
if npm view "@wirecat/zoom-cli@$version" version --prefer-online >/dev/null 2>&1; then
  echo "$version is already published; prepare a new version in a pull request" >&2
  exit 1
fi
last_run() {
  gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
    --json databaseId --jq '.[0].databaseId // ""'
}
previous=$(last_run)
gh workflow run release.yml --ref main
run=""
for _ in $(seq 30); do
  run=$(last_run)
  [ -n "$run" ] && [ "$run" != "$previous" ] && break
  run=""
  sleep 2
done
[ -n "$run" ] || { echo "release dispatch not found; check GitHub Actions" >&2; exit 1; }
if ! gh run watch "$run" --exit-status; then
  echo "release failed; inspect: gh run view $run --log-failed" >&2
  echo "for an unpublished package, check the first-publication setup in docs/dev/RELEASING.md" >&2
  exit 1
fi
npm view "@wirecat/zoom-cli@$version" version --prefer-online
git fetch -q --tags origin
git rev-parse --verify "refs/tags/v$version" >/dev/null
echo "published @wirecat/zoom-cli@$version"
