#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."
self=$(git hash-object bin/release)
# The fold fast-forwards main, and sh reads this file as it goes: a newer bin/release would run half old, half new.
# Run the new one from the start instead: the second run finds the fold already on main.
rerun_if_changed() {
  [ "$(git hash-object bin/release)" != "$self" ] || return 0
  [ -z "${WIRECAT_RELEASE_RERUN:-}" ] || { echo "bin/release changed again while releasing — run it again" >&2; exit 1; }
  echo "bin/release changed on main — running the new one"
  export WIRECAT_RELEASE_RERUN=1
  exec ./bin/release "$@"
}
mode=ci
case "$*" in
  "") ;;
  --local) mode=local ;;
  *) echo "usage: bin/release [--local]" >&2; exit 2 ;;
esac
git fetch -q origin
[ "$(git branch --show-current)" = main ] || { echo "run from main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "update main to origin/main first" >&2; exit 1; }
# One release of this package at a time on this machine, as in cli-core.
. ./config/wirecat/release-lock.sh
wirecat_release_lock "${WIRECAT_RELEASE_WAIT_SECONDS:-0}"
if [ "$mode" = local ]; then
  exec node scripts/release-local.ts
fi
version=$(node -p 'require("./package.json").version')
# A pull request checked before the last release and merged after it put its entry in that release's section;
# restore moves it to Unreleased, so the fold below brings it into this version.
restored=$(npx -y -p @wirecat/cli-base@0.55.1 cli-dev changelog restore --land)
[ -z "$restored" ] || echo "$restored"
rerun_if_changed "$@"
# A session that merges after the version was dated, but before it was published, adds Unreleased above it.
# --land folds on a fresh main through its own pull request, and folds again once if main moves under it.
# cli-dev is pinned rather than taken from the dependencies: cli-core accepts only an older cli-base.
folded=""
npm view "@wirecat/zoom-cli@$version" version --prefer-online >/dev/null 2>&1 ||
  folded=$(npx -y -p @wirecat/cli-base@0.36.0 cli-dev changelog fold --land --version "$version")
[ -z "$folded" ] || echo "$folded"
rerun_if_changed "$@"
top=$(sed -n '/^## /{p;q;}' CHANGELOG.md)
case "$top" in
  "## $version — "*) ;;
  *) echo "date the top changelog section for $version before releasing" >&2; exit 1 ;;
esac
if npm view "@wirecat/zoom-cli@$version" version --prefer-online >/dev/null 2>&1; then
  echo "$version is already published; prepare a new version in a pull request" >&2
  exit 1
fi
last_run() {
  gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
    --json databaseId --jq '.[0].databaseId // ""'
}
previous=$(last_run)
gh workflow run release.yml --ref main -f commit="$(git rev-parse HEAD)"
run=""
for _ in $(seq 30); do
  run=$(last_run)
  [ -n "$run" ] && [ "$run" != "$previous" ] && break
  run=""
  sleep 2
done
[ -n "$run" ] || { echo "release dispatch not found; check GitHub Actions" >&2; exit 1; }
# gh run watch also exits non-zero when one of its own requests to GitHub fails, while the run goes on:
# only the run's conclusion says whether the release failed.
watch_release() {
  for _ in $(seq 30); do
    gh run watch "$run" --exit-status && return 0
    state=$(gh run view "$run" --json status,conclusion --jq '.status + ":" + .conclusion' 2>/dev/null || true)
    case "$state" in
      completed:success) return 0 ;;
      completed:*) return 1 ;;
    esac
    echo "lost the watch on release run $run; watching it again" >&2
    sleep 10
  done
  echo "lost track of release run $run — see gh run view $run" >&2
  exit 1
}
if ! watch_release; then
  echo "release failed; inspect: gh run view $run --log-failed" >&2
  echo "for an unpublished package, check the first-publication setup in docs/dev/RELEASING.md" >&2
  exit 1
fi
npm view "@wirecat/zoom-cli@$version" version --prefer-online
git fetch -q --tags origin
git rev-parse --verify "refs/tags/v$version" >/dev/null
echo "published @wirecat/zoom-cli@$version"
