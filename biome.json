{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./config/wirecat/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/pnpm-lock.yaml",
      "!docs/zoom-app.json",
      "!package-lock.json",
      "!.worktrees",
      "!config/wirecat",
      "!lint/baseline"
    ]
  },
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "linter": {
    "rules": {
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp.ts serves MCP; commands and services do not know the protocol"
                  },
                  {
                    "group": ["@wirecat/cli-core/store"],
                    "message": "src/store-connection.ts opens the shared store; the rest of zoom receives it as a dependency"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mcp-server.ts", "src/mcp.ts", "src/answers.ts", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@wirecat/cli-core/store"],
                    "message": "src/store-connection.ts opens the shared store; the rest of zoom receives it as a dependency"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/store-connection.ts", "src/meeting-context.ts", "src/meeting-semantic.ts", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp.ts serves MCP; commands and services do not know the protocol"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/installed-*.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ]
}
